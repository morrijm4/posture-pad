{
    "$schema": "https://raw.githubusercontent.com/SchemaStore/schemastore/refs/heads/master/src/schemas/json/package.json",
    "name": "posture-pad",
    "type": "module",
    "private": true,
    "packageManager": "pnpm@10.32.1+sha512.a706938f0e89ac1456b6563eab4edf1d1faf3368d1191fc5c59790e96dc918e4456ab2e67d613de1043d2e8c81f87303e6b40d4ffeca9df15ef1ad567348f2be",
    "scripts": {
        "build": "docker compose --env-file ./.env.local build",
        "dev": "concurrently -k -n \"docker,esbuild\" -c \"cyan,green\" \"docker compose --env-file ./.env.local up --build --watch\" \"pnpm -F @pp/mqtt dev\"",
        "deploy": "docker save posture-pad-mqtt-listener:latest | ssh lonos \"docker load\" && scp docker-compose.yml apps/mqtt/mosquitto.conf lonos:/home/mm/test && scp .env.local lonos:/home/mm/app/.env"
    },
    "peerDependencies": {
        "typescript": "^5"
    },
    "devDependencies": {
        "concurrently": "^9.2.1"
    }
}
