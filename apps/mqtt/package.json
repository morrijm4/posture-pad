{
    "$schema": "https://raw.githubusercontent.com/SchemaStore/schemastore/refs/heads/master/src/schemas/json/package.json",
    "name": "@pp/mqtt",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "files": [
        "dist/build/listener.js"
    ],
    "scripts": {
        "build": "node ./esbuild.config.js build",
        "dev": "concurrently -n \"listener,broker\" -c \"cyan,green\" \"node ./esbuild.config.js watch\"",
        "start": "node ./esbuild.config.js watch",
        "keygen": "bash keygen.sh"
    },
    "dependencies": {
        "@pp/db": "workspace:*",
        "mqtt": "^5.15.0"
    },
    "devDependencies": {
        "esbuild": "^0.27.4"
    }
}
